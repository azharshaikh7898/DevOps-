#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/user-data-nat.log | logger -t user-data-nat -s 2>/dev/console) 2>&1

sysctl -w net.ipv4.ip_forward=1
apt-get update
apt-get install -y iptables-persistent
snap install amazon-ssm-agent --classic || true
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true
iptables -t nat -C POSTROUTING -s "${vpc_cidr}" -o eth0 -j MASQUERADE 2>/dev/null || iptables -t nat -A POSTROUTING -s "${vpc_cidr}" -o eth0 -j MASQUERADE
iptables -C FORWARD -s "${vpc_cidr}" -j ACCEPT 2>/dev/null || iptables -A FORWARD -s "${vpc_cidr}" -j ACCEPT
netfilter-persistent save
systemctl enable netfilter-persistent || true

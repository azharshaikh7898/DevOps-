#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/user-data-private.log | logger -t user-data-private -s 2>/dev/console) 2>&1

apt-get update
apt-get install -y ca-certificates curl gnupg jq awscli docker.io unzip
snap install amazon-ssm-agent --classic || true
systemctl enable --now docker
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true
usermod -aG docker ubuntu || true

install -d /opt/iii-stack/deploy/config /etc/iii-stack /var/log/iii-stack

# If an attached EBS device exists at /dev/xvdf, format and mount it to /opt/models
if [ -b /dev/xvdf ]; then
	if ! blkid /dev/xvdf >/dev/null 2>&1; then
		mkfs.ext4 -F /dev/xvdf
	fi
	install -d /opt/models
	mount /dev/xvdf /opt/models || true
	# Ensure fstab entry
	grep -q '/opt/models' /etc/fstab || echo '/dev/xvdf /opt/models ext4 defaults,nofail 0 2' >> /etc/fstab
	install -d /opt/models/gemma-3-270m
	aws s3 sync "s3://${model_bucket_name}/${model_s3_prefix}" "/opt/models/gemma-3-270m"
else
	# Fallback to root disk if EBS not attached
	install -d /opt/models/gemma-3-270m
	aws s3 sync "s3://${model_bucket_name}/${model_s3_prefix}" "/opt/models/gemma-3-270m"
fi

cat >/etc/iii-stack/runtime.env <<EOF
AWS_REGION=${aws_region}
III_URL=ws://${engine_dns}:${rpc_port}
INFERENCE_IMAGE=${inference_image}:latest
MODEL_PATH=${model_path}
EOF

cat >/etc/systemd/system/inference-worker.service <<'EOF'
[Unit]
Description=III Inference Worker
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/iii-stack/runtime.env
ExecStartPre=/bin/bash -lc 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$(echo "$INFERENCE_IMAGE" | cut -d/ -f1)" && docker pull "$INFERENCE_IMAGE"'
ExecStart=/bin/bash -lc 'docker run --rm --name inference-worker --network host -e III_URL="$III_URL" -e MODEL_PATH="$MODEL_PATH" -v /opt/models/gemma-3-270m:/models "$INFERENCE_IMAGE"'
ExecStop=/usr/bin/docker stop inference-worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iii-stack /opt/models /var/log/iii-stack /etc/iii-stack

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload

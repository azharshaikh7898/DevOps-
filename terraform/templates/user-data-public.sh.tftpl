#!/usr/bin/env bash
set -euo pipefail

exec > >(tee /var/log/user-data-public.log | logger -t user-data-public -s 2>/dev/console) 2>&1

apt-get update
apt-get install -y ca-certificates curl gnupg jq awscli docker.io unzip
snap install amazon-ssm-agent --classic || true
systemctl enable --now docker
systemctl enable --now snap.amazon-ssm-agent.amazon-ssm-agent.service || true
usermod -aG docker ubuntu || true

install -d /opt/iii-stack/deploy/config /etc/iii-stack /var/log/iii-stack

cat >/opt/iii-stack/deploy/config/config.yaml <<EOF
workers:
  - name: iii-http
    config:
      host: 0.0.0.0
      port: ${http_api_port}

  - name: inference-worker
    worker_path: /opt/iii-stack/inference-worker

  - name: caller-worker
    worker_path: /opt/iii-stack/caller-worker
EOF

cat >/etc/iii-stack/runtime.env <<EOF
AWS_REGION=${aws_region}
III_URL=ws://${engine_dns}:${rpc_port}
ENGINE_IMAGE=${engine_image}:latest
CALLER_IMAGE=${caller_image}:latest
EOF

cat >/etc/systemd/system/iii-engine.service <<'EOF'
[Unit]
Description=III Engine
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=simple
EnvironmentFile=/etc/iii-stack/runtime.env
ExecStartPre=/bin/bash -lc 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$(echo "$ENGINE_IMAGE" | cut -d/ -f1)" && docker pull "$ENGINE_IMAGE"'
ExecStart=/bin/bash -lc 'docker run --rm --name iii-engine --network host -v /opt/iii-stack/deploy/config/config.yaml:/app/deploy/config/config.yaml:ro "$ENGINE_IMAGE"'
ExecStop=/usr/bin/docker stop iii-engine
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iii-stack /var/log/iii-stack /etc/iii-stack

[Install]
WantedBy=multi-user.target
EOF

cat >/etc/systemd/system/caller-worker.service <<'EOF'
[Unit]
Description=III Caller Worker
Wants=network-online.target docker.service iii-engine.service
After=network-online.target docker.service iii-engine.service

[Service]
Type=simple
EnvironmentFile=/etc/iii-stack/runtime.env
ExecStartPre=/bin/bash -lc 'aws ecr get-login-password --region "$AWS_REGION" | docker login --username AWS --password-stdin "$(echo "$CALLER_IMAGE" | cut -d/ -f1)" && docker pull "$CALLER_IMAGE"'
ExecStart=/bin/bash -lc 'docker run --rm --name caller-worker --network host -e III_URL="$III_URL" "$CALLER_IMAGE"'
ExecStop=/usr/bin/docker stop caller-worker
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/iii-stack /var/log/iii-stack /etc/iii-stack

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload
